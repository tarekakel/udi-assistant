{
  "welcomeFile": "/index.html",
  "authenticationMethod": "route",
  "logout": {
    "logoutEndpoint": "/logout"
  },
  "routes": [
    {
      "source": "^/api/assistant/(.*)$",
      "target": "/api/assistant/$1",
      "destination": "srv-api",
      "authenticationType": "xsuaa",
      "scope": ["$XSAPPNAME.Viewer", "$XSAPPNAME.Editor"],
      "csrfProtection": false
    },
    {
      "source": "^/api/(.*)$",
      "target": "/api/$1",
      "destination": "srv-api",
      "authenticationType": "xsuaa",
      "scope": {
        "GET": ["$XSAPPNAME.Viewer", "$XSAPPNAME.Editor"],
        "HEAD": ["$XSAPPNAME.Viewer", "$XSAPPNAME.Editor"],
        "default": "$XSAPPNAME.Editor"
      },
      "csrfProtection": false
    },
    {
      "source": "^/user-api/currentUser$",
      "service": "sap-approuter-userapi",
      "authenticationType": "xsuaa"
    },
    {
      "source": "^/(.*)$",
      "target": "$1",
      "localDir": "resources",
      "authenticationType": "xsuaa"
    }
  ]
}
